generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  password_hash String  @db.VarChar(255)
  name         String   @db.VarChar(255)
  role         String   @default("staff") @db.VarChar(20)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp
  updated_at   DateTime @updatedAt @db.Timestamp

  inventory_transactions_created InventoryTransaction[] @relation("TransactionCreatedBy")
  inventory_transactions_updated InventoryTransaction[] @relation("TransactionUpdatedBy")
  audit_logs                     AuditLog[]

  @@map("users")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(255)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp
  updated_at   DateTime @updatedAt @db.Timestamp

  inventory_transactions InventoryTransaction[]

  @@map("products")
}

model Vendor {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(255)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp
  updated_at   DateTime @updatedAt @db.Timestamp

  inventory_transactions InventoryTransaction[]

  @@map("vendors")
}

model Location {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp

  inventory_transactions_src InventoryTransaction[] @relation("SourceLocation")
  inventory_transactions_dst InventoryTransaction[] @relation("DestLocation")

  @@map("locations")
}

model InventoryTransaction {
  id                    Int      @id @default(autoincrement())
  transaction_type      String   @db.VarChar(20)
  product_id            Int?
  vendor_id             Int?
  item_name_snapshot    String?  @db.VarChar(255)
  quantity              Decimal  @db.Decimal(10, 2)
  source_location_id    Int?
  destination_location_id Int?
  transaction_date      DateTime @db.Timestamp
  reason                String?
  is_deleted            Boolean  @default(false)
  created_by            Int?
  updated_by            Int?
  created_at            DateTime @default(now()) @db.Timestamp
  updated_at            DateTime @updatedAt @db.Timestamp

  product               Product?  @relation(fields: [product_id], references: [id])
  vendor                Vendor?   @relation(fields: [vendor_id], references: [id])
  source_location       Location? @relation("SourceLocation", fields: [source_location_id], references: [id])
  destination_location  Location? @relation("DestLocation", fields: [destination_location_id], references: [id])
  created_by_user       User?     @relation("TransactionCreatedBy", fields: [created_by], references: [id])
  updated_by_user       User?     @relation("TransactionUpdatedBy", fields: [updated_by], references: [id])

  @@index([product_id])
  @@index([vendor_id])
  @@index([transaction_type])
  @@index([transaction_date])
  @@index([source_location_id])
  @@index([destination_location_id])
  @@index([is_deleted])
  @@index([product_id, transaction_date])
  @@map("inventory_transactions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(50)
  entity_type String   @db.VarChar(50)
  entity_id   Int?
  old_values  Json?
  new_values  Json?
  created_at  DateTime @default(now()) @db.Timestamp

  user        User?    @relation(fields: [user_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_logs")
}
